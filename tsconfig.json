{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "$lib": ["./ui/src/lib"], "$lib/*": ["./ui/src/lib/*"] },
    "types": ["vite/client"]
  },
  "include": ["ui/src/**/*.ts", "ui/src/**/*.svelte", "vite.config.ts"]
}
